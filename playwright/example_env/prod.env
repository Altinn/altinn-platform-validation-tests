# Kopier til playwright/.env.prod.local og fyll inn hemmelighetene.
# Fila er gitignorert. Vil du heller ha verdiene i shellet: set -a && . <fil> && set +a

AF_UI_BASE_URL=https://af.altinn.no
AM_UI_BASE_URL=https://am.ui.altinn.no
INFO_CLOUD_URL=https://info.altinn.no
BASE_URL=https://platform.altinn.no

# Bare nødvendig hvis du sourcer fila. Kjører du npm-scriptene, setter de den selv.
ENVIRONMENT=prod

# Syntetisk Tenor-bruker, måned 81-92. Testbrukeren her skal ikke sjekkes inn.
TEST_USER_PID=
TEST_USER_NAME=

# Delt tilgangspassord for innlogging som syntetisk bruker.
TEST_IDP_PASSWORD=
