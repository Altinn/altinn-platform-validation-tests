# Kopier til playwright/.env.at22.local og fyll inn hemmelighetene.
# Fila er gitignorert. Vil du heller ha verdiene i shellet: set -a && . <fil> && set +a

AF_UI_BASE_URL=https://af.at22.altinn.cloud
AM_UI_BASE_URL=https://am.ui.at22.altinn.cloud
INFO_CLOUD_URL=https://info.at22.altinn.cloud
BASE_URL=https://platform.at22.altinn.cloud

# Bare nødvendig hvis du sourcer fila. Kjører du npm-scriptene, setter de den selv.
ENVIRONMENT=at22

# Midlertidig fallback når testdatafilen mangler. Kjør da med --workers=1.
# Syntetisk Tenor-bruker, måned 81-92, med rollen testen krever.
TEST_USER_PID=
TEST_USER_NAME=
