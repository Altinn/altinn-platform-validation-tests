# Kopier til playwright/.env.at23.local og fyll inn hemmelighetene.
# Fila er gitignorert. Vil du heller ha verdiene i shellet: set -a && . <fil> && set +a

AF_UI_BASE_URL=https://af.at23.altinn.cloud
AM_UI_BASE_URL=https://am.ui.at23.altinn.cloud
INFO_CLOUD_URL=https://info.at23.altinn.cloud
BASE_URL=https://platform.at23.altinn.cloud

# Bare nødvendig hvis du sourcer fila. Kjører du npm-scriptene, setter de den selv.
ENVIRONMENT=at23

# Delt tilgangspassord for innlogging som syntetisk bruker.
TEST_IDP_PASSWORD=
