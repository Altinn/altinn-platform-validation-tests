# Kopier til playwright/.env.tt02.local. Testbrukerne ligger i testdata/ og
# passordet i .env, så det er ingenting å fylle inn her.
# Fila er gitignorert. Vil du heller ha verdiene i shellet: set -a && . <fil> && set +a

AF_UI_BASE_URL=https://af.tt02.altinn.no
AM_UI_BASE_URL=https://am.ui.tt02.altinn.no
INFO_CLOUD_URL=https://info.tt02.altinn.no
BASE_URL=https://platform.tt02.altinn.no

# Bare nødvendig hvis du sourcer fila. Kjører du npm-scriptene, setter de den selv.
ENVIRONMENT=tt02
