# Kopier til playwright/.env. Verdier som allerede er satt i shellet vinner.

# Delt tilgangspassord for Mockporten. Trengs i prod, og for røyktesten av
# Mockporten i at23 og tt02.
TEST_IDP_PASSWORD=

# Valgfritt: en annen testdata-mappe enn playwright/testdata, med samme oppbygning.
# TEST_DATA_PATH=

# Samme testverktøy k6-testene bruker (se K6/example_env/), til å hente
# personlige/enterprise-tokens for PDP-kall og for å opprette testdialoger via
# dialogporten-serviceowner-API-et.
TOKEN_GENERATOR_USERNAME=
TOKEN_GENERATOR_PASSWORD=

# Kreves av /authorization/api/v1, som ligger bak API management. Se
# K6/api/tests/authorization/pdp-authorize/authorize-client.js.
AUTHORIZATION_SUBSCRIPTION_KEY=
