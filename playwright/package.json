        "csv-parse": "7.0.2",
        "dotenv": "17.4.2",
        "eslint": "10.11.0",
        "eslint-plugin-playwright": "2.12.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "jiti": "2.7.0",
