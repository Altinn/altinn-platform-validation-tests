{
    "name": "altinn-playwright-tests",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "test": "playwright test",
        "test:at23:flaky": "playwright test --project='at23-*' --repeat-each=10 --retries=1 --reporter=line",
        "test:at23": "playwright test --project='at23-*'",
        "test:tt02": "playwright test --project='tt02-*'",
        "test:prod": "playwright test --project='prod-*'",
        "test:at23:bokmaal": "playwright test --project='at23-chromium-bokmål'",
        "test:tt02:bokmaal": "playwright test --project='tt02-chromium-bokmål'",
        "test:prod:bokmaal": "playwright test --project='prod-chromium-bokmål'",
        "report": "playwright show-report --port 6060",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "fix": "eslint --fix .",
        "validate": "npm run lint && npm run typecheck"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "24.13.5",
        "dotenv": "17.4.2",
        "eslint": "10.11.0",
        "eslint-plugin-jsdoc": "64.5.4",
        "eslint-plugin-playwright": "2.12.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "jiti": "2.7.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1"
    },
    "directories": {
        "test": "tests"
    },
    "description": ""
}