# Copy to .env.at23 and fill in the token generator credentials.
TOKEN_GENERATOR_USERNAME=
TOKEN_GENERATOR_PASSWORD=

ENVIRONMENT=at23
DEPLOY_ENV=at23
ENV_TYPE=dev
BASE_URL=https://platform.at23.altinn.cloud
ALTINN2_BASE_URL=https://at23.altinn.cloud
ALTINN_CDN_BASE_URL=https://altinncdn.no
AM_UI_BASE_URL=https://am.ui.at23.altinn.cloud
AF_UI_BASE_URL=https://af.at23.altinn.cloud
INFO_CLOUD_URL=https://info.at23.altinn.cloud

# One functional iteration per test. Increase deliberately for load testing.
K6_VUS=1
K6_ITERATIONS=1
